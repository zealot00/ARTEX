# Docker deployment configuration (copy to .env)
# The image is built locally by `docker compose build`; there is no registry tag.
# Address the web UI is published on. 127.0.0.1 keeps it host-local; set 0.0.0.0
# to reach it from another machine or from Windows when ARTEX runs inside WSL.
ARTEX_BIND_ADDR=127.0.0.1
# Reverse proxies (comma-separated CIDRs) whose X-Forwarded-For the login rate
# limit trusts. Empty: the header is ignored. See "Reverse proxy deployment" in README.md.
ARTEX_TRUSTED_PROXIES=
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM (fill one or both; you can also leave empty and configure in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# Intranet LLM endpoint isolation & outbound hardening (optional)
# Comma-separated host, host:port, .suffix, or CIDR rules (e.g. 127.0.0.1:11434,.internal.corp,10.0.0.0/8)
ARTEX_LLM_HOST_ALLOWLIST=
ARTEX_LLM_REQUIRE_BASE_URL=
ARTEX_LLM_DISABLE_ENV_FALLBACK=
ARTEX_DISABLE_WEB_SEARCH=

# Intranet OOB callback, offline Nuclei templates, hot-loaded PoCs & offline Semgrep rules
# Set ARTEX_OOB_BASE_URL to an intranet IP:port reachable by target hosts (e.g. http://10.10.0.5:8787)
ARTEX_OOB_BASE_URL=
ARTEX_NUCLEI_TEMPLATES_DIR=/opt/nuclei-templates
ARTEX_POCS_DIR=/app/pocs
ARTEX_SEMGREP_RULES_DIR=

# Optional custom package mirror overrides for `docker compose build`
# When left empty, the Dockerfile automatically benchmarks global & regional mirrors
# (Americas, Europe, and Asia-Pacific) in parallel and selects the fastest one.
PIP_INDEX_URL=
GOPROXY=
NPM_REGISTRY=

# Untrusted-output boundary (optional). ARTEX_UNTRUSTED_BOUNDARY=1 frames every tool
# output between nonce-tagged markers so the model treats it as data, not instructions.
# Off by default; test it against a local target before enabling it in production.
# ARTEX_UNTRUSTED_BOUNDARY=1
